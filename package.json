{
  "name": "moah-pi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "moah": "bin/moah.mjs"
  },
  "files": [
    "bin/",
    "dist/src/",
    "scripts/measure-tree.ps1",
    "data/",
    "paper/",
    "*.md",
    "LICENSE",
    "CITATION.cff"
  ],
  "type": "module",
  "description": "Model-selected capability catalog and demand-loaded Pi tools",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/lean.test.ts",
    "test:package": "node scripts/check-release.mjs",
    "moah": "tsx src/cli.ts",
    "start": "tsx src/cli.ts pi"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "jiti": "2.7.0",
    "langsmith": "^0.10.4",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./dist/src/pi-extension.js"
    ]
  }
}
