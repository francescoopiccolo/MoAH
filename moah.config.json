{
  "selection": {
    "maxActiveTools": 6,
    "catalogPageSize": 40,
    "descriptionCharacters": 200,
    "resetOnPrompt": true,
    "releaseInactive": true
  },
  "router": {
    "enabled": true,
    "model": "Xenova/multilingual-e5-small",
    "device": "dml",
    "dtype": "q8",
    "topK": 2,
    "minimumScore": 0.2,
    "keepMargin": 0.01,
    "pinnedTools": ["read", "bash", "powershell", "edit", "write"],
    "maxQueryCharacters": 2400
  },
  "cache": {
    "maxProcesses": 2,
    "residentBudgetMb": 768,
    "idleTtlMs": 120000,
    "loadTimeoutMs": 30000,
    "callTimeoutMs": 120000
  },
  "packages": [
    {
      "id": "pi-web-tools",
      "package": "@bitcraft-apps/pi-web-tools",
      "version": "1.6.0",
      "entry": "index.ts",
      "stateless": true,
      "workerSdk": "lazy"
    }
  ]
}
